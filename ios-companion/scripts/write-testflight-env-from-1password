#!/usr/bin/env bash
set -euo pipefail

item='op://Personal/Apple Dev Connect Fastlane CI key Airlock'
key_file=".appstoreconnect/AuthKey_PB3CN6BW7C.p8"

need_op() {
  if ! command -v op >/dev/null 2>&1; then
    echo "1Password CLI is required. Install/sign in to op, then rerun this command." >&2
    exit 1
  fi
}

op_read() {
  op read "$1" 2>/dev/null
}

read_key_contents() {
  op_read "$item/ASK_KEY_CONTENTS" ||
    op_read "$item/ASC_KEY_CONTENTS" ||
    op_read "$item/AuthKey_PB3CN6BW7C.p8"
}

write_pem() {
  local raw="$1"
  local body key_label begin_marker end_marker
  key_label="PRIVATE KEY"
  begin_marker="-----BEGIN ${key_label}-----"
  end_marker="-----END ${key_label}-----"

  raw="${raw//$'\\r'/}"
  raw="${raw//\\n/$'\n'}"
  body="$(
    printf '%s' "$raw" |
      sed "s/${begin_marker}//g; s/${end_marker}//g" |
      tr -d '[:space:]'
  )"

  if [ -z "$body" ]; then
    echo "Could not read private key contents from 1Password." >&2
    exit 1
  fi

  mkdir -p "$(dirname "$key_file")"
  {
    echo "$begin_marker"
    printf '%s' "$body" | fold -w 64
    echo
    echo "$end_marker"
  } >"$key_file"
  chmod 600 "$key_file"
}

existing_env_value() {
  local name="$1"
  if [ -f .env.local ]; then
    awk -F= -v key="$name" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' .env.local
  fi
}

write_env() {
  local key_id="$1"
  local issuer_id="$2"
  local team_id="$3"
  local itc_team_id build_number release_notes testflight_groups
  itc_team_id="$(existing_env_value AIRLOCK_IOS_ITC_TEAM_ID)"
  build_number="$(existing_env_value AIRLOCK_IOS_BUILD_NUMBER)"
  release_notes="$(existing_env_value AIRLOCK_IOS_RELEASE_NOTES)"
  testflight_groups="$(existing_env_value AIRLOCK_IOS_TESTFLIGHT_GROUPS)"

  cat >.env.local <<EOF
APP_STORE_CONNECT_API_KEY_ID=$key_id
APP_STORE_CONNECT_API_ISSUER_ID=$issuer_id
APP_STORE_CONNECT_API_KEY_PATH=$PWD/$key_file

AIRLOCK_IOS_TEAM_ID=$team_id

# Optional. Set this if App Store Connect has multiple provider teams.
AIRLOCK_IOS_ITC_TEAM_ID=$itc_team_id

# Optional. Defaults to a UTC timestamp, which keeps TestFlight build numbers increasing.
AIRLOCK_IOS_BUILD_NUMBER=$build_number

# Optional. Appears as the TestFlight changelog.
AIRLOCK_IOS_RELEASE_NOTES=$release_notes

# Optional. Comma-separated internal TestFlight group names to receive every uploaded build.
AIRLOCK_IOS_TESTFLIGHT_GROUPS=$testflight_groups
EOF
  chmod 600 .env.local
}

need_op

key_id="$(op_read "$item/ASC_KEY_ID")"
issuer_id="$(op_read "$item/ASC_ISSUER_ID")"
team_id="$(op_read "op://Personal/Apple Developper/team id")"
key_contents="$(read_key_contents)"

if [ -z "$key_id" ] || [ -z "$issuer_id" ]; then
  echo "Could not read ASC_KEY_ID or ASC_ISSUER_ID from 1Password." >&2
  exit 1
fi
if [ -z "$team_id" ]; then
  echo "Could not read Apple Developer Team ID from 1Password." >&2
  exit 1
fi

write_pem "$key_contents"
write_env "$key_id" "$issuer_id" "$team_id"

echo "Wrote ios-companion/.env.local and ios-companion/$key_file."
