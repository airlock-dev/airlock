# Copy to .env.local and fill in values for local TestFlight uploads.
# .env.local is gitignored.

APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Optional alternative to APP_STORE_CONNECT_API_KEY_PATH.
# Prefer the path form locally so the multiline key does not live in .env.local.
APP_STORE_CONNECT_API_KEY_CONTENT=

# Required for Xcode signing. This is the 10-character Apple Developer Team ID.
AIRLOCK_IOS_TEAM_ID=

# Optional. Set this if App Store Connect has multiple provider teams.
AIRLOCK_IOS_ITC_TEAM_ID=

# Optional. Defaults to a UTC timestamp, which keeps TestFlight build numbers increasing.
AIRLOCK_IOS_BUILD_NUMBER=

# Optional. Appears as the TestFlight changelog.
AIRLOCK_IOS_RELEASE_NOTES=

# Optional. Comma-separated internal TestFlight group names to receive every uploaded build.
# If set, fastlane waits for build processing so it can attach the build to these groups.
AIRLOCK_IOS_TESTFLIGHT_GROUPS=
